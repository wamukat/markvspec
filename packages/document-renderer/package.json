{
  "name": "@markvspec/document-renderer",
  "version": "0.6.4",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "npm run build && rm -rf dist-test && tsc -p tsconfig.test.json && node --test dist-test/test/**/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@markvspec/core": "0.6.4"
  }
}
