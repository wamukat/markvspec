{
  "MarkVSpec Screen": {
    "prefix": "markvspec-screen",
    "description": "Create a MarkVSpec screen with states, responsive layouts, elements, and actions.",
    "body": [
      "---",
      "id: SCR-${1:SCREEN}",
      "type: screen",
      "title: ${2:Screen Title}",
      "route: ${3:/path}",
      "---",
      "",
      "# SCR-${1:SCREEN} ${2:Screen Title}",
      "",
      "## States",
      "",
      "- idle*",
      "",
      "## Layout: ${4:mobile}",
      "",
      "### ${5:L1}:${6:L-Page}",
      "",
      "- stack",
      "- gap: md",
      "",
      "#### Items",
      "",
      "- ${7:E-Heading}",
      "",
      "## Elements",
      "",
      "### ${8:1}:${7:E-Heading} Heading",
      "",
      "- level: 1",
      "- label: ${2:Screen Title}",
      "",
      "## Actions",
      "",
      "${0}"
    ]
  },
  "MarkVSpec Partial": {
    "prefix": "markvspec-partial",
    "description": "Create a MarkVSpec server-rendered partial document.",
    "body": [
      "---",
      "id: PRT-${1:PARTIAL}",
      "type: partial",
      "title: ${2:Partial Title}",
      "route: ${3:/partials/path}",
      "---",
      "",
      "# PRT-${1:PARTIAL} ${2:Partial Title}",
      "",
      "## States",
      "",
      "- loaded*",
      "- fetching",
      "- fetch-error",
      "",
      "## Layout: ${4:mobile}",
      "",
      "### ${5:L1}:${6:L-PartialRoot}",
      "",
      "- stack",
      "- gap: md",
      "",
      "#### Items",
      "",
      "- ${7:E-Content}",
      "",
      "## Elements",
      "",
      "### ${8:1}:${7:E-Content} Text",
      "",
      "- text: ${9:Content}",
      "",
      "## Events",
      "",
      "- partial.render: ${11:A-BuildPartial}",
      "",
      "## Actions",
      "",
      "### ${10:A1}:${11:A-BuildPartial} Build partial",
      "",
      "- From",
      "  - fetching",
      "- Process ${12:P1}: ${13:Call server service}",
      "  - server: ${14:Service.method()}",
      "  - case: success",
      "    - description: ${15:Success result}",
      "    - state: loaded",
      "  - case: failure",
      "    - description: ${16:Failure result}",
      "    - state: fetch-error",
      "${0}"
    ]
  },
  "MarkVSpec States": {
    "prefix": "markvspec-states",
    "description": "Create a MarkVSpec States section.",
    "body": [
      "## States",
      "",
      "- ${1:idle}*",
      "- ${2:wait-auth}",
      "- ${3:error}",
      "  - ${4:Error message.}",
      ""
    ]
  },
  "MarkVSpec Responsive Layouts": {
    "prefix": "markvspec-layouts-responsive",
    "description": "Create mobile and desktop Layout sections.",
    "body": [
      "## Layout: mobile",
      "",
      "### ${1:L1}:${2:L-Page}",
      "",
      "- stack",
      "- gap: md",
      "",
      "#### Items",
      "",
      "- ${3:E-Heading}",
      "",
      "## Layout: desktop",
      "",
      "### ${1:L1}:${2:L-Page}",
      "",
      "- row",
      "- gap: md",
      "",
      "#### Items",
      "",
      "- ${3:E-Heading}",
      "${0}"
    ]
  },
  "MarkVSpec Layout Group": {
    "prefix": "markvspec-layout",
    "description": "Create a MarkVSpec layout group with an Items subsection.",
    "body": [
      "### ${1:L1}:${2:L-Group}",
      "",
      "- ${3|stack,row,grid,inline|}",
      "- gap: ${4|none,xs,sm,md,lg,xl|}",
      "",
      "#### Items",
      "",
      "- ${5:E-Element}",
      "${0}"
    ]
  },
  "MarkVSpec Input Element": {
    "prefix": "markvspec-element-input",
    "description": "Create an Input element with value source and input constraints.",
    "body": [
      "### ${1:1}:${2:E-Input} Input",
      "",
      "- value: \\${data.${3:field}}",
      "- initial value: ${4:initial value}",
      "- input rule:",
      "  - ${5:type}: ${6:text}",
      "${0}"
    ]
  },
  "MarkVSpec Button Element": {
    "prefix": "markvspec-element-button",
    "description": "Create a Button element linked to an action.",
    "body": [
      "### ${1:2}:${2:E-Button} Button",
      "",
      "- label: ${3:Submit}",
      "- variant: ${4|primary,secondary,tertiary|}",
      "- tone: ${5|neutral,info,success,warning,danger|}",
      "- action: ${6:A-Submit}",
      "${0}"
    ]
  },
  "MarkVSpec Select Element": {
    "prefix": "markvspec-element-select",
    "description": "Create a Select element with Markdown list options.",
    "body": [
      "### ${1:3}:${2:E-Select} Select",
      "",
      "- value: \\${data.${3:status}}",
      "- initial value: ${4:Active}",
      "- options:",
      "  - ${4:Active}",
      "  - ${5:Inactive}",
      "${0}"
    ]
  },
  "MarkVSpec Action": {
    "prefix": "markvspec-action",
    "description": "Create a structured MarkVSpec action.",
    "body": [
      "### ${1:A1}:${2:A-Submit} ${3:Submit}",
      "",
      "- From",
      "  - ${4:idle}",
      "- Process ${5:P1}: ${6:Submit request}",
      "  - server:",
      "    - ${7|GET,POST,PUT,PATCH,DELETE|} ${8:/path}",
      "    - params:",
      "      - ${9:param}: ${10:E-Input}.value",
      "  - case: ${11:sent}",
      "    - state: ${13:wait-response}",
      "  - case: ${14:send-failed}",
      "    - state: ${15:error}",
      "- Process ${16:P2}: ${17:Handle response}",
      "  - receive:",
      "    - response: ${2:A-Submit}.${6:P1}.response",
      "  - case: ${18:success}",
      "    - response: ${19:2xx}",
      "    - navigate: ${20:SCR-NEXT}",
      "  - case: ${21:failure}",
      "    - response: ${22:4xx}",
      "    - state: ${23:error}",
      "${0}"
    ]
  }
}
