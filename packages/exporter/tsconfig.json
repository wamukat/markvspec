{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": "../..",
    "paths": {
      "@markvspec/core": [
        "packages/core/src/index.ts"
      ],
      "@markvspec/document-renderer": [
        "packages/document-renderer/src/index.ts"
      ]
    },
    "composite": true
  },
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../document-renderer"
    }
  ],
  "include": [
    "src/**/*.ts"
  ]
}
