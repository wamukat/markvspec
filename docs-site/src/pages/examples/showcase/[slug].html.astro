---
import {
  getExamples,
  groupExamplesByStage,
  githubBlobBaseUrl,
  githubRawBaseUrl,
  nextExamples,
  relatedDocs,
  sourceLines,
} from '../../../lib/example-data.js';

export function getStaticPaths() {
  return getExamples().map((example) => ({
    params: { slug: example.slug },
    props: { example },
  }));
}

const { example } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const examples = getExamples();
const stageGroups = groupExamplesByStage(examples);
const related = relatedDocs(example);
const next = nextExamples(example, examples);
const sourceHref = `${base}${example.sourceAssetPath}`;
const rawSourceHref = `${githubRawBaseUrl}${example.repoPath}`;
const dynamicPreviewConfig = {
  dependencies: {
    template: example.sourceDependencies.template
      ? { ...example.sourceDependencies.template, href: `${base}${example.sourceDependencies.template.href}` }
      : undefined,
    partials: example.sourceDependencies.partials.map((partial) => ({ ...partial, href: `${base}${partial.href}` })),
  },
  dynamicPreviewEnabled: true,
  locale: example.locale || 'en',
  rawSourceHref,
  sourceHref,
};
const githubRepositoryUrl = 'https://github.com/wamukat/markvspec';
const sourceLineItems = sourceLines(example.source);
const currentStage = stageGroups.find((stage) => stage.items.some((item) => item.slug === example.slug));
const currentStageIndex = currentStage?.items.findIndex((item) => item.slug === example.slug) ?? -1;
const adjacentByStage = currentStage && currentStageIndex >= 0
  ? [currentStage.items[currentStageIndex - 1], currentStage.items[currentStageIndex + 1]].filter(Boolean)
  : [];
const adjacentExamples = [
  ...next,
  ...adjacentByStage.filter((item) => !next.some((nextItem) => nextItem.slug === item.slug)),
];
const pageNavItems = [
  { href: '#source', label: 'Source pane' },
  { href: '#dynamic-preview', label: 'Dynamic preview' },
].filter(Boolean);
const metaPills = [
  example.id,
  example.type,
  example.kind ? `kind ${example.kind}` : '',
  example.stageLabel ? `category ${example.stageLabel}` : '',
  example.route ? `route ${example.route}` : '',
  example.locale ? `locale ${example.locale}` : '',
].filter(Boolean);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{example.title} - MarkVSpec Example Showcase</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="stylesheet" href={`${base}/examples/assets/markvspec-preview.css`} />
    <style>
      :root {
        --page: #f6f7f9;
        --paper: #fff;
        --ink: #172033;
        --muted: #617083;
        --line: #d6dde8;
        --line-soft: #e9edf3;
        --accent: #2563eb;
        --success: #047857;
        --warning: #b45309;
        --code-bg: #101827;
        --code-ink: #e8eef8;
        --code-muted: #95a3b8;
      }
      * { box-sizing: border-box; }
      body {
        background: var(--page);
        color: var(--ink);
        font: 14px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        margin: 0;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .site-header {
        background: var(--paper);
        border-bottom: 1px solid var(--line);
        position: sticky;
        top: 0;
        z-index: 10;
      }
      .site-header-inner {
        align-items: center;
        display: flex;
        gap: 16px;
        justify-content: space-between;
        margin: 0 auto;
        max-width: 1440px;
        padding: 12px 24px;
      }
      .brand {
        align-items: center;
        display: grid;
        gap: 2px 9px;
        grid-template-columns: 30px 1fr;
      }
      .brand img {
        border-radius: 7px;
        grid-row: 1 / span 2;
        height: 30px;
        width: 30px;
      }
      .brand strong { font-size: 15px; }
      .brand span { color: var(--muted); font-size: 12px; }
      .top-nav,
      .example-actions,
      .pane-tools {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: flex-end;
      }
      .nav-link,
      .button-link,
      .small-link {
        align-items: center;
        border: 1px solid var(--line);
        border-radius: 999px;
        display: inline-flex;
        font-size: 12px;
        font-weight: 650;
        gap: 6px;
        line-height: 1.2;
        padding: 7px 11px;
        text-decoration: none;
        white-space: nowrap;
      }
      .nav-link svg,
      .button-link svg,
      .small-link svg {
        flex: 0 0 auto;
        height: 15px;
        width: 15px;
      }
      .nav-link,
      .small-link {
        background: #fff;
        color: #334155;
      }
      .button-link {
        background: var(--accent);
        border-color: var(--accent);
        color: #fff;
      }
      .button-link:hover {
        color: #fff;
      }
      main {
        display: grid;
        gap: 18px;
        grid-template-columns: 260px minmax(0, 1fr);
        margin: 0 auto;
        max-width: 1440px;
        padding: 22px 24px 40px;
      }
      main[data-sidebar-collapsed="true"] {
        grid-template-columns: 54px minmax(0, 1fr);
      }
      .example-sidebar {
        align-self: start;
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 8px;
        max-height: calc(100vh - 92px);
        overflow: auto;
        padding: 14px;
        position: sticky;
        top: 70px;
      }
      .example-sidebar-header {
        align-items: center;
        display: flex;
        gap: 8px;
        justify-content: space-between;
        margin-bottom: 12px;
      }
      .example-sidebar-title {
        color: var(--ink);
        display: block;
        font-size: 14px;
        font-weight: 750;
        min-width: 0;
      }
      .example-sidebar-toggle {
        align-items: center;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 999px;
        color: #334155;
        cursor: pointer;
        display: inline-flex;
        flex: 0 0 auto;
        font: inherit;
        font-size: 12px;
        font-weight: 750;
        gap: 4px;
        justify-content: center;
        line-height: 1;
        min-height: 30px;
        padding: 5px 9px;
      }
      .example-sidebar-toggle:hover {
        border-color: #b8c3d3;
      }
      .sidebar-toggle-icon {
        font-size: 15px;
        line-height: 1;
      }
      main[data-sidebar-collapsed="true"] .example-sidebar {
        overflow: visible;
        padding: 10px;
      }
      main[data-sidebar-collapsed="true"] .example-sidebar-header {
        justify-content: center;
        margin-bottom: 0;
      }
      main[data-sidebar-collapsed="true"] .example-sidebar-title,
      main[data-sidebar-collapsed="true"] .sidebar-toggle-label {
        display: none;
      }
      .example-sidebar-section {
        border-top: 1px solid var(--line-soft);
        padding: 12px 0;
      }
      .example-sidebar-section:first-of-type {
        border-top: 0;
        padding-top: 0;
      }
      .example-sidebar-heading {
        color: var(--muted);
        font-size: 11px;
        font-weight: 750;
        letter-spacing: .04em;
        margin: 0 0 7px;
        text-transform: uppercase;
      }
      .example-sidebar ul {
        display: grid;
        gap: 3px;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .example-sidebar a {
        border-radius: 6px;
        color: #334155;
        display: block;
        font-size: 12px;
        font-weight: 650;
        line-height: 1.35;
        padding: 6px 8px;
      }
      .example-sidebar a[aria-current="page"] {
        background: #eaf1ff;
        color: var(--accent);
      }
      .example-main { min-width: 0; }
      .example-header {
        align-items: end;
        display: grid;
        gap: 14px;
        grid-template-columns: minmax(0, 1fr) auto;
        margin-bottom: 18px;
      }
      .breadcrumb {
        color: var(--muted);
        font-size: 12px;
        margin-bottom: 8px;
      }
      h1 {
        font-size: 26px;
        letter-spacing: 0;
        line-height: 1.25;
        margin: 0;
      }
      .subtitle {
        color: var(--muted);
        margin: 8px 0 0;
        max-width: 760px;
      }
      .context-heading {
        color: var(--muted);
        font-size: 11px;
        font-weight: 750;
        letter-spacing: .04em;
        margin: 0 0 8px;
        text-transform: uppercase;
      }
      .meta-row {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }
      .pill {
        align-items: center;
        background: #f8fafc;
        border: 1px solid var(--line-soft);
        border-radius: 999px;
        color: #334155;
        display: inline-flex;
        font-size: 11px;
        font-weight: 650;
        gap: 5px;
        padding: 3px 8px;
      }
      .page-jump-nav {
        align-items: center;
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 8px;
        display: flex;
        gap: 10px;
        margin-bottom: 18px;
        overflow-x: auto;
        padding: 10px 12px;
      }
      .page-jump-nav strong {
        color: var(--muted);
        flex: 0 0 auto;
        font-size: 11px;
        letter-spacing: .04em;
        text-transform: uppercase;
      }
      .page-jump-nav a {
        border: 1px solid var(--line-soft);
        border-radius: 999px;
        color: #334155;
        flex: 0 0 auto;
        font-size: 12px;
        font-weight: 650;
        padding: 5px 9px;
      }
      .learning-panel,
      .learning-card,
      .pane {
        scroll-margin-top: 86px;
      }
      .split {
        display: grid;
        gap: 16px;
        grid-template-columns: minmax(360px, .9fr) minmax(520px, 1.1fr);
        min-height: calc(100vh - 185px);
      }
      .learning-panel {
        display: grid;
        gap: 14px;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        margin-top: 18px;
      }
      .learning-card {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 14px;
      }
      .learning-card h2 {
        font-size: 13px;
        margin: 0 0 8px;
      }
      .learning-card ul {
        display: grid;
        gap: 6px;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .learning-card li {
        color: var(--muted);
        font-size: 13px;
      }
      .learning-card .meta-row {
        margin-top: 2px;
      }
      .pane {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 8px;
        box-shadow: 0 10px 24px rgba(15, 23, 42, .05);
        min-width: 0;
        overflow: hidden;
      }
      .pane-header {
        align-items: center;
        background: #fbfcfe;
        border-bottom: 1px solid var(--line);
        display: flex;
        gap: 12px;
        justify-content: space-between;
        min-height: 48px;
        padding: 10px 14px;
      }
      .pane-title { display: grid; gap: 1px; }
      .pane-title strong { font-size: 13px; }
      .pane-title span { color: var(--muted); font-size: 11px; }
      .runtime-status {
        background: #eef2ff;
        border: 1px solid #c7d2fe;
        border-radius: 999px;
        color: #3730a3;
        display: inline-flex;
        font-size: 11px;
        font-weight: 750;
        line-height: 1.2;
        padding: 5px 8px;
        white-space: nowrap;
      }
      .runtime-status[data-status="ready"] {
        background: #ecfdf5;
        border-color: #a7f3d0;
        color: var(--success);
      }
      .runtime-status[data-status="diagnostics"],
      .runtime-status[data-status="fallback"] {
        background: #fffbeb;
        border-color: #fde68a;
        color: var(--warning);
      }
      .runtime-metrics {
        background: #fbfcfe;
        border-bottom: 1px solid var(--line-soft);
        color: var(--muted);
        font-size: 11px;
        margin: 0;
        padding: 7px 14px;
      }
      .source-wrap {
        background: var(--code-bg);
        color: var(--code-ink);
        height: calc(100vh - 252px);
        min-height: 520px;
        overflow: auto;
      }
      .source-wrap pre {
        font-size: 0;
        line-height: 0;
        margin: 0;
        min-width: 620px;
        padding: 12px 0;
        tab-size: 2;
      }
      .source-wrap code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
        font-size: 0;
        line-height: 0;
      }
      .line {
        display: grid;
        font-size: 12px;
        grid-template-columns: 44px minmax(0, 1fr);
        height: 18px;
        line-height: 18px;
      }
      .line-no {
        color: var(--code-muted);
        padding-right: 12px;
        text-align: right;
        user-select: none;
      }
      .line-code {
        border-left: 1px solid rgba(148, 163, 184, .22);
        padding: 0 18px;
        white-space: pre;
      }
      .dynamic-preview-output,
      .fallback-frame-wrap {
        background: #eef2f7;
        height: calc(100vh - 252px);
        min-height: 520px;
        overflow: auto;
      }
      .dynamic-preview-output {
        padding: 18px;
      }
      .dynamic-preview-output[hidden],
      .fallback-frame-wrap[hidden] {
        display: none;
      }
      .dynamic-preview-failure {
        background: #fff;
        border: 1px solid #fbbf24;
        border-radius: 8px;
        color: #334155;
        margin: 18px;
        padding: 16px;
      }
      .dynamic-preview-failure h3 {
        color: #92400e;
        font-size: 15px;
        margin: 0 0 8px;
      }
      .dynamic-preview-failure p {
        margin: 0 0 12px;
      }
      .dynamic-preview-failure-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }
      .dynamic-preview-failure-links a {
        border: 1px solid var(--line);
        border-radius: 999px;
        color: #334155;
        font-size: 12px;
        font-weight: 700;
        padding: 6px 10px;
      }
      iframe {
        background: #fff;
        border: 0;
        display: block;
        height: 100%;
        min-height: 520px;
        width: 100%;
      }
      @media (max-width: 1000px) {
        main,
        main[data-sidebar-collapsed="true"] {
          grid-template-columns: 1fr;
        }
        .example-main { order: 1; }
        .example-sidebar {
          max-height: none;
          order: 2;
          position: static;
        }
        .example-header {
          align-items: start;
          grid-template-columns: 1fr;
        }
        .example-actions { justify-content: flex-start; }
        .page-jump-nav {
          margin-left: -4px;
          margin-right: -4px;
        }
        .learning-panel { grid-template-columns: 1fr; }
        .split { grid-template-columns: 1fr; }
        .source-wrap,
        .dynamic-preview-output,
        .fallback-frame-wrap {
          height: auto;
          max-height: 680px;
        }
      }
      @media (max-width: 640px) {
        .site-header-inner {
          align-items: flex-start;
          flex-direction: column;
        }
        .top-nav,
        .example-actions {
          justify-content: flex-start;
          max-width: 100%;
          width: 100%;
        }
        .example-actions .nav-link,
        .example-actions .button-link {
          justify-content: center;
          white-space: normal;
        }
        .pane,
        .source-wrap,
        .dynamic-preview-output,
        .fallback-frame-wrap {
          max-width: 100%;
        }
        .source-wrap pre {
          min-width: 0;
          width: max-content;
        }
        main {
          padding: 16px 14px 32px;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <div class="brand">
          <img src={`${base}/assets/markvspec-icon.svg`} alt="" width="30" height="30" />
          <strong>MarkVSpec Examples</strong>
          <span>Source and dynamic preview, side by side</span>
        </div>
        <nav class="top-nav" aria-label="Example navigation">
          <a class="nav-link" href={`${base}/en/`}>
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 7v14" />
              <path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z" />
            </svg>
            <span>Docs</span>
          </a>
          <a class="nav-link" href={githubRepositoryUrl}>
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
              <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.08 1.83 2.82 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.31-5.47-1.34-5.47-5.94 0-1.31.47-2.38 1.23-3.22-.12-.3-.53-1.53.12-3.18 0 0 1-.32 3.3 1.23a11.47 11.47 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.65.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.62-2.81 5.63-5.49 5.93.43.37.82 1.1.82 2.22v3.29c0 .32.21.7.83.58A12 12 0 0 0 12 .5Z" />
            </svg>
            <span>GitHub</span>
          </a>
        </nav>
      </div>
    </header>

    <main data-example-layout>
      <aside class="example-sidebar" aria-label="Example navigation">
        <div class="example-sidebar-header">
          <a class="example-sidebar-title" href={`${base}/examples/`}>All Examples</a>
          <button class="example-sidebar-toggle" type="button" aria-controls="example-sidebar-content" aria-expanded="true" aria-label="Hide example navigation" data-sidebar-toggle>
            <span class="sidebar-toggle-icon" aria-hidden="true" data-sidebar-toggle-icon>‹</span>
            <span class="sidebar-toggle-label" data-sidebar-toggle-label>Hide</span>
          </button>
        </div>
        <div id="example-sidebar-content" class="example-sidebar-content">
          {stageGroups.map((stage) => (
            <section class="example-sidebar-section">
              <p class="example-sidebar-heading">{stage.label}</p>
              <ul>
                {stage.items.map((item) => (
                  <li>
                    <a href={`${base}/examples/showcase/${item.slug}.html`} aria-current={item.slug === example.slug ? 'page' : undefined}>{item.title}</a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </aside>

      <div class="example-main">
        <section class="example-header">
          <div>
            <div class="breadcrumb">Examples / {example.relativeExamplePath}</div>
            <h1>{example.title}</h1>
            <p class="subtitle">{example.summary}</p>
          </div>
          <div class="example-actions">
            <a class="button-link" href={sourceHref}>Open source asset</a>
            <a class="nav-link" href={`${githubBlobBaseUrl}${example.repoPath}`}>View on GitHub</a>
          </div>
        </section>

        <nav class="page-jump-nav" aria-label="Sections in this example">
          <strong>On this example</strong>
          {pageNavItems.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>

        <section class="split" aria-label="Source and dynamic preview">
          <article id="source" class="pane" aria-label="VSpec source">
            <div class="pane-header">
              <div class="pane-title">
                <strong>{example.slug}.vspec.md</strong>
                <span>Markdown source</span>
              </div>
              <div class="pane-tools">
                <a class="small-link" href={`${githubRawBaseUrl}${example.repoPath}`}>Source</a>
              </div>
            </div>
            <div class="source-wrap">
              <pre><code>{sourceLineItems.map((line) => (
                <span class="line"><span class="line-no">{line.number}</span><span class="line-code">{line.text}</span></span>
              ))}</code></pre>
            </div>
          </article>

          <article id="dynamic-preview" class="pane" aria-label="Dynamic preview">
            <div class="pane-header">
              <div class="pane-title">
                <strong>Dynamic Preview</strong>
                <span>Browser-rendered from the published source asset</span>
              </div>
              <div class="pane-tools">
                <span class="runtime-status" data-dynamic-preview-status data-status="loading">Waiting for browser runtime...</span>
                <a class="small-link" href={rawSourceHref}>Raw source</a>
              </div>
            </div>
            <p class="runtime-metrics" data-dynamic-preview-metrics>Runtime metrics are measured in the browser.</p>
            <div class="dynamic-preview-output" data-dynamic-preview-output hidden></div>
            <div class="fallback-frame-wrap" data-dynamic-preview-fallback hidden></div>
          </article>
        </section>

        <section id="learning-links" class="learning-panel" aria-label="Learning links">
          <article class="learning-card">
            <p class="context-heading">Example details</p>
            <div class="meta-row" aria-label="Example metadata">
              {metaPills.map((pill) => <span class="pill">{pill}</span>)}
            </div>
          </article>
          <article class="learning-card">
            <h2>What this teaches</h2>
            <ul>
              {example.teaches.length ? example.teaches.map((item) => <li>{item}</li>) : <li>No catalog teaches metadata.</li>}
            </ul>
          </article>
          <article id="related-docs" class="learning-card">
            <h2>Related docs</h2>
            <ul>
              {related.length ? related.map((doc) => <li><a href={`${base}${doc.href}`}>{doc.label}</a></li>) : <li>No related docs.</li>}
            </ul>
          </article>
          <article id="adjacent-examples" class="learning-card">
            <h2>Adjacent examples</h2>
            <ul>
              {adjacentExamples.length ? adjacentExamples.map((item) => <li><a href={`${base}/examples/showcase/${item.slug}.html`}>{item.title}</a></li>) : <li>No adjacent example.</li>}
            </ul>
          </article>
        </section>
      </div>
    </main>
    <script id="dynamic-preview-config" type="application/json" set:html={JSON.stringify(dynamicPreviewConfig)}></script>
    <script is:inline src={`${base}/examples/assets/markvspec-mermaid.js`}></script>
    <script is:inline src={`${base}/examples/assets/markvspec-mermaid-runtime.js`}></script>
    <script>import '../../../lib/dynamic-preview.js';</script>
    <script is:inline>
      (() => {
        const layout = document.querySelector('[data-example-layout]');
        const button = document.querySelector('[data-sidebar-toggle]');
        const content = document.querySelector('#example-sidebar-content');
        const icon = document.querySelector('[data-sidebar-toggle-icon]');
        const label = document.querySelector('[data-sidebar-toggle-label]');
        if (!layout || !button || !content || !icon || !label) return;

        const setCollapsed = (collapsed) => {
          layout.dataset.sidebarCollapsed = collapsed ? 'true' : 'false';
          button.setAttribute('aria-expanded', String(!collapsed));
          button.setAttribute('aria-label', collapsed ? 'Show example navigation' : 'Hide example navigation');
          content.hidden = collapsed;
          icon.textContent = collapsed ? '›' : '‹';
          label.textContent = collapsed ? 'Show' : 'Hide';
        };

        setCollapsed(window.matchMedia('(max-width: 1000px)').matches);
        button.addEventListener('click', () => {
          setCollapsed(layout.dataset.sidebarCollapsed !== 'true');
        });
      })();
    </script>
  </body>
</html>
