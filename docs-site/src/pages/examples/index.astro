---
import {
  getExamples,
  getLearningPath,
  groupExamplesByKind,
  groupExamplesByStage,
  githubBlobBaseUrl,
  generatedPdfExists,
} from '../../lib/example-data.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const examples = getExamples();
const learningPath = getLearningPath(examples);
const stageGroups = groupExamplesByStage(examples);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MarkVSpec Examples</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <style>
      :root {
        color: #172033;
        background: #f8fafc;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }
      body { margin: 0; }
      main {
        margin: 0 auto;
        max-width: 1040px;
        padding: 40px 24px 64px;
      }
      .page-title {
        align-items: center;
        display: flex;
        gap: 12px;
        margin-bottom: 8px;
      }
      .page-title img {
        border-radius: 8px;
        height: 38px;
        width: 38px;
      }
      h1 {
        font-size: 34px;
        line-height: 1.2;
        margin: 0;
      }
      p {
        color: #526178;
        line-height: 1.65;
        margin: 0 0 24px;
      }
      section { margin-top: 30px; }
      h2 {
        border-bottom: 1px solid #d7dee8;
        font-size: 19px;
        margin: 0 0 12px;
        padding-bottom: 8px;
      }
      h3 {
        color: #526178;
        font-size: 13px;
        letter-spacing: .02em;
        margin: 16px 0 8px;
        text-transform: uppercase;
      }
      ul {
        display: grid;
        gap: 10px;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      li {
        background: #fff;
        border: 1px solid #d7dee8;
        border-radius: 8px;
        display: grid;
        gap: 6px;
        padding: 14px 16px;
      }
      .card-title {
        align-items: baseline;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }
      .summary {
        color: #526178;
        font-size: 13px;
        margin: 0;
      }
      .teaches,
      .path {
        color: #68778d;
        font-size: 12px;
        margin: 0;
      }
      .path {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      }
      .pill {
        background: #eef2ff;
        border: 1px solid #c7d2fe;
        border-radius: 999px;
        color: #3730a3;
        font-size: 11px;
        font-weight: 750;
        padding: 2px 7px;
      }
      a {
        color: #0f766e;
        font-weight: 750;
        text-decoration: none;
      }
      a:hover { text-decoration: underline; }
      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }
      .source {
        font-size: 13px;
        font-weight: 750;
      }
      .primary { color: #115e59; }
    </style>
  </head>
  <body>
    <main>
      <div class="page-title">
        <img src={`${base}/assets/markvspec-icon.svg`} alt="" width="38" height="38" />
        <h1>MarkVSpec Examples</h1>
      </div>
      <p>Browse examples by the screen pattern you want to copy. Open Source + Preview to compare the Markdown source with the generated output, or use Preview when you only need the rendered document.</p>

      <section>
        <h2>Learning Path</h2>
        <ul>
          {learningPath.map((example, index) => (
            <li>
              <div class="card-title">
                <a href={`${base}/examples/showcase/${example.slug}.html`}>{example.title}</a>
                <span class="pill">Step {index + 1}</span>
                <span class="pill">{example.kind}</span>
              </div>
              <p class="summary">{example.summary}</p>
              {example.teaches.length ? <p class="teaches">Teaches: {example.teaches.join(', ')}</p> : null}
              <p class="path">{example.repoPath}</p>
              <div class="actions">
                <a class="source primary" href={`${base}/examples/showcase/${example.slug}.html`}>Source + Preview</a>
                <a class="source" href={`${base}/examples/generated/${example.slug}.html`}>Preview</a>
                {generatedPdfExists(example.slug) ? <a class="source" href={`${base}/examples/generated/${example.slug}.pdf`}>PDF</a> : null}
                <a class="source" href={`${githubBlobBaseUrl}${example.repoPath}`}>Source</a>
              </div>
            </li>
          ))}
        </ul>
      </section>

      {stageGroups.map((stage) => (
        <section>
          <h2>{stage.label}</h2>
          {groupExamplesByKind(stage.items).map((kind) => (
            <div>
              <h3>{kind.label}</h3>
              <ul>
                {kind.items.map((example) => (
                  <li>
                    <div class="card-title">
                      <a href={`${base}/examples/showcase/${example.slug}.html`}>{example.title}</a>
                      <span class="pill">{example.kind}</span>
                    </div>
                    <p class="summary">{example.summary}</p>
                    {example.teaches.length ? <p class="teaches">Teaches: {example.teaches.join(', ')}</p> : null}
                    <p class="path">{example.repoPath}</p>
                    <div class="actions">
                      <a class="source primary" href={`${base}/examples/showcase/${example.slug}.html`}>Source + Preview</a>
                      <a class="source" href={`${base}/examples/generated/${example.slug}.html`}>Preview</a>
                      {generatedPdfExists(example.slug) ? <a class="source" href={`${base}/examples/generated/${example.slug}.pdf`}>PDF</a> : null}
                      <a class="source" href={`${githubBlobBaseUrl}${example.repoPath}`}>Source</a>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      ))}
    </main>
  </body>
</html>
