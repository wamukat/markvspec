---
import {
  getExamples,
  getLearningPath,
  groupExamplesByKind,
  groupExamplesByStage,
  getProjectExamples,
} from '../../lib/example-data.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const examples = getExamples();
const learningPath = getLearningPath(examples);
const projectExamples = getProjectExamples();
const stageGroups = groupExamplesByStage(examples);
const githubRepositoryUrl = 'https://github.com/wamukat/markvspec';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MarkVSpec Examples</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <style>
      :root {
        color: #172033;
        background: #f8fafc;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }
      body { margin: 0; }
      .site-header {
        background: #fff;
        border-bottom: 1px solid #d7dee8;
        position: sticky;
        top: 0;
        z-index: 10;
      }
      .site-header-inner {
        align-items: center;
        display: flex;
        gap: 16px;
        justify-content: space-between;
        margin: 0 auto;
        max-width: 1440px;
        padding: 12px 24px;
      }
      .brand {
        align-items: center;
        display: grid;
        gap: 2px 9px;
        grid-template-columns: 30px 1fr;
      }
      .brand img {
        border-radius: 7px;
        grid-row: 1 / span 2;
        height: 30px;
        width: 30px;
      }
      .brand strong { font-size: 15px; }
      .brand span { color: #617083; font-size: 12px; }
      .top-nav {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: flex-end;
      }
      .nav-link {
        align-items: center;
        background: #fff;
        border: 1px solid #d7dee8;
        border-radius: 999px;
        color: #334155;
        display: inline-flex;
        font-size: 12px;
        font-weight: 650;
        gap: 6px;
        line-height: 1.2;
        padding: 7px 11px;
        text-decoration: none;
        white-space: nowrap;
      }
      .nav-link svg {
        flex: 0 0 auto;
        height: 15px;
        width: 15px;
      }
      main {
        margin: 0 auto;
        max-width: 1040px;
        padding: 40px 24px 64px;
      }
      .page-title {
        align-items: center;
        display: flex;
        gap: 12px;
        margin-bottom: 8px;
      }
      .page-title img {
        border-radius: 8px;
        height: 38px;
        width: 38px;
      }
      h1 {
        font-size: 34px;
        line-height: 1.2;
        margin: 0;
      }
      p {
        color: #526178;
        line-height: 1.65;
        margin: 0 0 24px;
      }
      section { margin-top: 30px; }
      h2 {
        border-bottom: 1px solid #d7dee8;
        font-size: 19px;
        margin: 0 0 12px;
        padding-bottom: 8px;
      }
      h3 {
        color: #526178;
        font-size: 13px;
        letter-spacing: .02em;
        margin: 16px 0 8px;
        text-transform: uppercase;
      }
      ul {
        display: grid;
        gap: 10px;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      li {
        background: #fff;
        border: 1px solid #d7dee8;
        border-radius: 8px;
        display: grid;
        gap: 6px;
        padding: 14px 16px;
      }
      .card-title {
        align-items: baseline;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }
      .summary {
        color: #526178;
        font-size: 13px;
        margin: 0;
      }
      .teaches,
      .path {
        color: #68778d;
        font-size: 12px;
        margin: 0;
      }
      .path {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      }
      .pill {
        background: #eef2ff;
        border: 1px solid #c7d2fe;
        border-radius: 999px;
        color: #3730a3;
        font-size: 11px;
        font-weight: 750;
        padding: 2px 7px;
      }
      a {
        color: #0f766e;
        font-weight: 750;
        text-decoration: none;
      }
      a:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <div class="brand">
          <img src={`${base}/assets/markvspec-icon.svg`} alt="" width="30" height="30" />
          <strong>MarkVSpec Examples</strong>
          <span>Source and browser-generated design document</span>
        </div>
        <nav class="top-nav" aria-label="Example navigation">
          <a class="nav-link" href={`${base}/en/`}>
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 7v14" />
              <path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z" />
            </svg>
            <span>Docs</span>
          </a>
          <a class="nav-link" href={githubRepositoryUrl}>
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
              <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.08 1.83 2.82 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.31-5.47-1.34-5.47-5.94 0-1.31.47-2.38 1.23-3.22-.12-.3-.53-1.53.12-3.18 0 0 1-.32 3.3 1.23a11.47 11.47 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.65.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.62-2.81 5.63-5.49 5.93.43.37.82 1.1.82 2.22v3.29c0 .32.21.7.83.58A12 12 0 0 0 12 .5Z" />
            </svg>
            <span>GitHub</span>
          </a>
        </nav>
      </div>
    </header>
    <main>
      <div class="page-title">
        <img src={`${base}/assets/markvspec-icon.svg`} alt="" width="38" height="38" />
        <h1>MarkVSpec Examples</h1>
      </div>
      <p>Browse examples by the screen pattern you want to copy. Open a title to compare the Markdown source with the generated output.</p>

      <section>
        <h2>Project-Level Examples</h2>
        <ul>
          {projectExamples.map((example) => (
            <li>
              <div class="card-title">
                <a href={example.href}>{example.title}</a>
                <span class="pill">project</span>
              </div>
              <p class="summary">{example.summary}</p>
              {example.teaches.length ? <p class="teaches">Teaches: {example.teaches.join(', ')}</p> : null}
              <p class="path">{example.repoPath}</p>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Learning Path</h2>
        <ul>
          {learningPath.map((example, index) => (
            <li>
              <div class="card-title">
                <a href={`${base}/examples/showcase/${example.slug}.html`}>{example.title}</a>
                <span class="pill">Step {index + 1}</span>
                <span class="pill">{example.kind}</span>
              </div>
              <p class="summary">{example.summary}</p>
              {example.teaches.length ? <p class="teaches">Teaches: {example.teaches.join(', ')}</p> : null}
              <p class="path">{example.repoPath}</p>
            </li>
          ))}
        </ul>
      </section>

      {stageGroups.map((stage) => (
        <section>
          <h2>{stage.label}</h2>
          {groupExamplesByKind(stage.items).map((kind) => (
            <div>
              <h3>{kind.label}</h3>
              <ul>
                {kind.items.map((example) => (
                  <li>
                    <div class="card-title">
                      <a href={`${base}/examples/showcase/${example.slug}.html`}>{example.title}</a>
                      <span class="pill">{example.kind}</span>
                    </div>
                    <p class="summary">{example.summary}</p>
                    {example.teaches.length ? <p class="teaches">Teaches: {example.teaches.join(', ')}</p> : null}
                    <p class="path">{example.repoPath}</p>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      ))}
    </main>
  </body>
</html>
