---
import {
  getExamples,
  githubRawBaseUrl,
} from '../../../../lib/example-data.js';

export function getStaticPaths() {
  return getExamples().map((example) => ({
    params: { slug: example.slug },
    props: { example },
  }));
}

const { example } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sourceHref = `${base}${example.sourceAssetPath}`;
const dynamicPreviewHref = `${base}${example.dynamicPreviewPath}`;
const githubRepositoryUrl = 'https://github.com/wamukat/markvspec';
const config = {
  fileName: `${example.slug}.vspec.md`,
  locale: example.locale || 'en',
  sourceHref,
};
const decisionRows = [
  ['Editor library', 'Native textarea for this PoC; evaluate CodeMirror only after editing requirements justify the bundle and integration cost.'],
  ['Bundle', 'Uses the existing browser-safe core API plus a small editor runtime; no syntax editor dependency is introduced in this step.'],
  ['Accessibility', 'Textarea preserves keyboard and screen-reader behavior; diagnostics are rendered as text near the editor.'],
  ['Mobile', 'Responsive single-column fallback works, but sustained mobile authoring remains a later decision.'],
  ['Save/share', 'Local copy and download only; URL snapshots, Gist handoff, and server persistence remain follow-up candidates.'],
  ['Production exposure', 'Direct experimental route only; no catalog, showcase, or docs navigation links point here.'],
];
---

<!doctype html>
<html lang="en" data-pagefind-ignore>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{example.title} - MarkVSpec Online Live Editor PoC</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <style>
      :root {
        --editor-canvas: #f5f7fb;
        --editor-paper: #ffffff;
        --editor-ink: #172033;
        --editor-muted: #617083;
        --editor-border: rgba(93, 111, 136, .28);
        --editor-border-soft: rgba(93, 111, 136, .16);
        --editor-accent: #2563eb;
        --editor-code: #101827;
        --editor-code-ink: #e8eef8;
        --editor-success: #0f766e;
        --editor-warning: #a16207;
        --editor-danger: #b91c1c;
      }
      * { box-sizing: border-box; }
      body {
        background: var(--editor-canvas);
        color: var(--editor-ink);
        font: 14px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        margin: 0;
      }
      a { color: var(--editor-accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .site-header {
        background: var(--editor-paper);
        border-bottom: 1px solid var(--editor-border);
        position: sticky;
        top: 0;
        z-index: 10;
      }
      .site-header-inner {
        align-items: center;
        display: flex;
        gap: 16px;
        justify-content: space-between;
        margin: 0 auto;
        max-width: 1500px;
        padding: 12px 24px;
      }
      .brand {
        align-items: center;
        display: grid;
        gap: 2px 9px;
        grid-template-columns: 30px 1fr;
      }
      .brand img {
        border-radius: 7px;
        grid-row: 1 / span 2;
        height: 30px;
        width: 30px;
      }
      .brand strong { font-size: 15px; }
      .brand span { color: var(--editor-muted); font-size: 12px; }
      .top-nav,
      .toolbar {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: flex-end;
      }
      .nav-link,
      .tool-button {
        align-items: center;
        background: #fff;
        border: 1px solid var(--editor-border);
        border-radius: 999px;
        color: #334155;
        display: inline-flex;
        font: inherit;
        font-size: 12px;
        font-weight: 650;
        gap: 6px;
        line-height: 1.2;
        padding: 7px 11px;
        text-decoration: none;
        white-space: nowrap;
      }
      .tool-button {
        cursor: pointer;
      }
      main {
        margin: 0 auto;
        max-width: 1500px;
        padding: 22px 24px 40px;
      }
      .editor-header {
        align-items: end;
        display: grid;
        gap: 14px;
        grid-template-columns: minmax(0, 1fr) auto;
        margin-bottom: 16px;
      }
      .breadcrumb {
        color: var(--editor-muted);
        font-size: 12px;
        margin-bottom: 8px;
      }
      h1 {
        font-size: 26px;
        letter-spacing: 0;
        line-height: 1.25;
        margin: 0;
      }
      .subtitle {
        color: var(--editor-muted);
        margin: 8px 0 0;
        max-width: 820px;
      }
      .status-strip {
        background: var(--editor-paper);
        border: 1px solid var(--editor-border);
        border-radius: 8px;
        display: grid;
        gap: 6px;
        margin-bottom: 16px;
        padding: 12px 14px;
      }
      [data-online-editor-status] {
        color: var(--editor-muted);
        font-weight: 750;
      }
      [data-online-editor-status][data-status="ready"] { color: var(--editor-success); }
      [data-online-editor-status][data-status="diagnostics"] { color: var(--editor-warning); }
      [data-online-editor-status][data-status="error"] { color: var(--editor-danger); }
      [data-online-editor-metrics] {
        color: var(--editor-muted);
        font-size: 12px;
      }
      .workspace {
        display: grid;
        gap: 16px;
        grid-template-columns: minmax(420px, .92fr) minmax(520px, 1.08fr);
      }
      .pane,
      .decision-panel {
        background: var(--editor-paper);
        border: 1px solid var(--editor-border);
        border-radius: 8px;
        box-shadow: 0 10px 24px rgba(15, 23, 42, .05);
        min-width: 0;
        overflow: hidden;
      }
      .pane-header {
        align-items: center;
        background: #fbfcfe;
        border-bottom: 1px solid var(--editor-border);
        display: flex;
        gap: 12px;
        justify-content: space-between;
        min-height: 48px;
        padding: 10px 14px;
      }
      .pane-title {
        display: grid;
        gap: 1px;
      }
      .pane-title strong { font-size: 13px; }
      .pane-title span { color: var(--editor-muted); font-size: 11px; }
      textarea {
        background: var(--editor-code);
        border: 0;
        color: var(--editor-code-ink);
        display: block;
        font: 12px/1.55 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
        height: calc(100vh - 292px);
        min-height: 560px;
        outline: none;
        padding: 16px;
        resize: vertical;
        tab-size: 2;
        width: 100%;
      }
      textarea:focus {
        box-shadow: inset 0 0 0 2px rgba(37, 99, 235, .75);
      }
      .preview-output {
        background: #eef2f7;
        height: calc(100vh - 292px);
        min-height: 560px;
        overflow: auto;
        padding: 18px;
      }
      .diagnostics-list {
        display: grid;
        gap: 8px;
        list-style: none;
        margin: 0;
        max-height: 210px;
        overflow: auto;
        padding: 14px;
      }
      .diagnostics-list li {
        background: #f8fafc;
        border: 1px solid var(--editor-border-soft);
        border-radius: 6px;
        color: #334155;
        font-size: 12px;
        padding: 8px 10px;
      }
      .diagnostics-list li[data-severity="error"] {
        border-color: #fecaca;
        color: #991b1b;
      }
      .diagnostics-list li[data-severity="warning"] {
        border-color: #fde68a;
        color: #92400e;
      }
      .decision-panel {
        margin-top: 16px;
      }
      .decision-panel table {
        border-collapse: collapse;
        width: 100%;
      }
      .decision-panel th,
      .decision-panel td {
        border-top: 1px solid var(--editor-border-soft);
        font-size: 12px;
        padding: 10px 12px;
        text-align: left;
        vertical-align: top;
      }
      .decision-panel th {
        color: #334155;
        width: 170px;
      }
      .decision-panel td {
        color: var(--editor-muted);
      }
      .editor-error-preview {
        background: #fff7ed;
        border: 1px solid #fed7aa;
        border-radius: 8px;
        color: #9a3412;
        padding: 14px;
      }
      @media (max-width: 1100px) {
        .editor-header,
        .workspace {
          grid-template-columns: 1fr;
        }
        .toolbar,
        .top-nav {
          justify-content: flex-start;
        }
        textarea,
        .preview-output {
          height: auto;
          max-height: 680px;
          min-height: 420px;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <div class="brand">
          <img src={`${base}/assets/markvspec-icon.svg`} alt="" width="30" height="30" />
          <strong>Online Live Editor PoC</strong>
          <span>Experimental direct route</span>
        </div>
        <nav class="top-nav" aria-label="Online editor navigation">
          <a class="nav-link" href={dynamicPreviewHref}>Read-only dynamic preview</a>
          <a class="nav-link" href={`${githubRawBaseUrl}${example.repoPath}`}>Source</a>
          <a class="nav-link" href={githubRepositoryUrl}>GitHub</a>
        </nav>
      </div>
    </header>

    <main data-pagefind-ignore>
      <section class="editor-header">
        <div>
          <div class="breadcrumb">Examples / Experimental editor / {example.relativeExamplePath}</div>
          <h1>{example.title}</h1>
          <p class="subtitle">{example.summary}</p>
        </div>
        <div class="toolbar" aria-label="Editor actions">
          <button class="tool-button" type="button" data-online-editor-reset>Reset</button>
          <button class="tool-button" type="button" data-online-editor-copy>Copy</button>
          <a class="tool-button" href="#" data-online-editor-download>Download</a>
        </div>
      </section>

      <section class="status-strip" aria-label="Online editor runtime status">
        <span data-online-editor-status data-status="loading">Waiting for editor runtime...</span>
        <span data-online-editor-metrics>Runtime metrics are measured in the browser.</span>
      </section>

      <section class="workspace" aria-label="Source editor and live preview">
        <article class="pane" aria-label="MarkVSpec source editor">
          <div class="pane-header">
            <div class="pane-title">
              <strong>{example.slug}.vspec.md</strong>
              <span>Native textarea editor</span>
            </div>
          </div>
          <textarea data-online-editor-source spellcheck="false" aria-label={`${example.title} MarkVSpec source`}></textarea>
        </article>

        <div>
          <article class="pane" aria-label="Live preview">
            <div class="pane-header">
              <div class="pane-title">
                <strong>Live Preview</strong>
                <span>Updates from the edited source</span>
              </div>
            </div>
            <div class="preview-output" data-online-editor-preview></div>
          </article>

          <article class="pane" aria-label="Diagnostics">
            <div class="pane-header">
              <div class="pane-title">
                <strong>Diagnostics</strong>
                <span>parse / validate result</span>
              </div>
            </div>
            <ul class="diagnostics-list" data-online-editor-diagnostics>
              <li>Waiting for editor runtime.</li>
            </ul>
          </article>
        </div>
      </section>

      <section class="decision-panel" aria-label="PoC decision notes">
        <div class="pane-header">
          <div class="pane-title">
            <strong>PoC Decision Notes</strong>
            <span>Not production navigation</span>
          </div>
        </div>
        <table>
          <tbody>
            {decisionRows.map(([label, value]) => (
              <tr>
                <th scope="row">{label}</th>
                <td>{value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    </main>

    <script id="online-live-editor-config" type="application/json" set:html={JSON.stringify(config)}></script>
    <script>
      import '../../../../lib/online-live-editor.js';
    </script>
  </body>
</html>
