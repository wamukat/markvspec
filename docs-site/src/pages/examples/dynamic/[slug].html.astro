---
import {
  getExamples,
  groupExamplesByStage,
  githubRawBaseUrl,
} from '../../../lib/example-data.js';

export function getStaticPaths() {
  return getExamples().map((example) => ({
    params: { slug: example.slug },
    props: { example },
  }));
}

const { example } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const examples = getExamples();
const stageGroups = groupExamplesByStage(examples);
const sourceHref = `${base}${example.sourceAssetPath}`;
const rawSourceHref = `${githubRawBaseUrl}${example.repoPath}`;
const showcaseHref = `${base}/examples/showcase/${example.slug}.html`;
const githubRepositoryUrl = 'https://github.com/wamukat/markvspec';
const config = {
  dependencies: {
    template: example.sourceDependencies.template
      ? { ...example.sourceDependencies.template, href: `${base}${example.sourceDependencies.template.href}` }
      : undefined,
    partials: example.sourceDependencies.partials.map((partial) => ({ ...partial, href: `${base}${partial.href}` })),
  },
  locale: example.locale || 'en',
  rawSourceHref,
  sourceHref,
};
const metaPills = [
  example.id,
  example.type,
  example.kind ? `kind ${example.kind}` : '',
  example.stageLabel ? `category ${example.stageLabel}` : '',
  example.route ? `route ${example.route}` : '',
  example.locale ? `locale ${example.locale}` : '',
].filter(Boolean);
---

<!doctype html>
<html lang="en" data-pagefind-ignore>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{example.title} - MarkVSpec Read-only Dynamic Preview</title>
    <link rel="canonical" href={showcaseHref} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="stylesheet" href={`${base}/examples/assets/markvspec-preview.css`} />
    <style>
      :root {
        --page: #f6f7f9;
        --paper: #fff;
        --ink: #172033;
        --muted: #617083;
        --line: #d6dde8;
        --line-soft: #e9edf3;
        --accent: #2563eb;
        --success: #0f766e;
        --warning: #a16207;
      }
      * { box-sizing: border-box; }
      body {
        background: var(--page);
        color: var(--ink);
        font: 14px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        margin: 0;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .site-header {
        background: var(--paper);
        border-bottom: 1px solid var(--line);
        position: sticky;
        top: 0;
        z-index: 10;
      }
      .site-header-inner {
        align-items: center;
        display: flex;
        gap: 16px;
        justify-content: space-between;
        margin: 0 auto;
        max-width: 1440px;
        padding: 12px 24px;
      }
      .brand {
        align-items: center;
        display: grid;
        gap: 2px 9px;
        grid-template-columns: 30px 1fr;
      }
      .brand img {
        border-radius: 7px;
        grid-row: 1 / span 2;
        height: 30px;
        width: 30px;
      }
      .brand strong { font-size: 15px; }
      .brand span { color: var(--muted); font-size: 12px; }
      .top-nav,
      .example-actions {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: flex-end;
      }
      .nav-link {
        align-items: center;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 999px;
        color: #334155;
        display: inline-flex;
        font-size: 12px;
        font-weight: 650;
        gap: 6px;
        line-height: 1.2;
        padding: 7px 11px;
        text-decoration: none;
        white-space: nowrap;
      }
      .nav-link svg {
        flex: 0 0 auto;
        height: 15px;
        width: 15px;
      }
      main {
        display: grid;
        gap: 18px;
        grid-template-columns: 260px minmax(0, 1fr);
        margin: 0 auto;
        max-width: 1440px;
        padding: 22px 24px 40px;
      }
      main[data-sidebar-collapsed="true"] {
        grid-template-columns: 54px minmax(0, 1fr);
      }
      .example-sidebar {
        align-self: start;
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 8px;
        max-height: calc(100vh - 92px);
        overflow: auto;
        padding: 14px;
        position: sticky;
        top: 70px;
      }
      .example-sidebar-header {
        align-items: center;
        display: flex;
        gap: 8px;
        justify-content: space-between;
        margin-bottom: 12px;
      }
      .example-sidebar-title {
        color: var(--ink);
        display: block;
        font-size: 14px;
        font-weight: 750;
        min-width: 0;
      }
      .example-sidebar-toggle {
        align-items: center;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 999px;
        color: #334155;
        cursor: pointer;
        display: inline-flex;
        flex: 0 0 auto;
        font: inherit;
        font-size: 12px;
        font-weight: 750;
        gap: 4px;
        justify-content: center;
        line-height: 1;
        min-height: 30px;
        padding: 5px 9px;
      }
      .example-sidebar-toggle:hover {
        border-color: #b8c3d3;
      }
      .sidebar-toggle-icon {
        font-size: 15px;
        line-height: 1;
      }
      main[data-sidebar-collapsed="true"] .example-sidebar {
        overflow: visible;
        padding: 10px;
      }
      main[data-sidebar-collapsed="true"] .example-sidebar-header {
        justify-content: center;
        margin-bottom: 0;
      }
      main[data-sidebar-collapsed="true"] .example-sidebar-title,
      main[data-sidebar-collapsed="true"] .sidebar-toggle-label {
        display: none;
      }
      .example-sidebar-section {
        border-top: 1px solid var(--line-soft);
        padding: 12px 0;
      }
      .example-sidebar-section:first-of-type {
        border-top: 0;
        padding-top: 0;
      }
      .example-sidebar-heading {
        color: var(--muted);
        font-size: 11px;
        font-weight: 750;
        letter-spacing: .04em;
        margin: 0 0 7px;
        text-transform: uppercase;
      }
      .example-sidebar ul {
        display: grid;
        gap: 3px;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .example-sidebar a {
        border-radius: 6px;
        color: #334155;
        display: block;
        font-size: 12px;
        font-weight: 650;
        line-height: 1.35;
        padding: 6px 8px;
      }
      .example-sidebar a[aria-current="page"] {
        background: #eaf1ff;
        color: var(--accent);
      }
      .example-main { min-width: 0; }
      .example-header {
        align-items: end;
        display: grid;
        gap: 14px;
        grid-template-columns: minmax(0, 1fr) auto;
        margin-bottom: 18px;
      }
      .breadcrumb {
        color: var(--muted);
        font-size: 12px;
        margin-bottom: 8px;
      }
      h1 {
        font-size: 26px;
        letter-spacing: 0;
        line-height: 1.25;
        margin: 0;
      }
      .subtitle {
        color: var(--muted);
        margin: 8px 0 0;
        max-width: 760px;
      }
      .meta-row {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 12px;
      }
      .pill {
        align-items: center;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 999px;
        color: #334155;
        display: inline-flex;
        font-size: 12px;
        font-weight: 650;
        gap: 5px;
        padding: 4px 9px;
      }
      .runtime-summary {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 8px;
        display: grid;
        gap: 8px;
        margin-bottom: 18px;
        padding: 14px;
      }
      .runtime-summary strong {
        font-size: 13px;
      }
      .runtime-summary p {
        color: var(--muted);
        margin: 0;
      }
      [data-dynamic-preview-status] {
        align-items: center;
        color: var(--muted);
        display: inline-flex;
        font-size: 12px;
        gap: 6px;
        font-weight: 700;
      }
      [data-dynamic-preview-status]::before {
        background: #94a3b8;
        border-radius: 999px;
        content: "";
        display: inline-block;
        height: 7px;
        width: 7px;
      }
      [data-dynamic-preview-status][data-status="ready"] { color: var(--success); }
      [data-dynamic-preview-status][data-status="diagnostics"],
      [data-dynamic-preview-status][data-status="fallback"] { color: var(--warning); }
      [data-dynamic-preview-status][data-status="ready"]::before { background: var(--success); }
      [data-dynamic-preview-status][data-status="diagnostics"]::before,
      [data-dynamic-preview-status][data-status="fallback"]::before { background: var(--warning); }
      [data-dynamic-preview-metrics] {
        color: var(--muted);
        font-size: 11px;
      }
      .preview-shell {
        display: grid;
        gap: 16px;
        grid-template-columns: minmax(0, 1fr) 320px;
      }
      .preview-pane,
      .diagnostics-pane {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 8px;
        box-shadow: 0 10px 24px rgba(15, 23, 42, .05);
        min-width: 0;
        overflow: hidden;
      }
      .pane-header {
        align-items: center;
        background: #fbfcfe;
        border-bottom: 1px solid var(--line);
        display: flex;
        gap: 12px;
        justify-content: space-between;
        min-height: 48px;
        padding: 10px 14px;
      }
      .pane-title { display: grid; gap: 1px; }
      .pane-title strong { font-size: 13px; }
      .pane-title span { color: var(--muted); font-size: 11px; }
      .dynamic-preview-output,
      .fallback-frame-wrap {
        background: #eef2f7;
        height: calc(100vh - 260px);
        min-height: 560px;
        overflow: auto;
        padding: 18px;
      }
      .dynamic-preview-output[hidden],
      .fallback-frame-wrap[hidden] {
        display: none;
      }
      .dynamic-preview-failure {
        background: #fff;
        border: 1px solid #fbbf24;
        border-radius: 8px;
        color: #334155;
        margin: 0;
        padding: 16px;
      }
      .dynamic-preview-failure h3 {
        color: #92400e;
        font-size: 15px;
        margin: 0 0 8px;
      }
      .dynamic-preview-failure p {
        margin: 0 0 12px;
      }
      .dynamic-preview-failure-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }
      .dynamic-preview-failure-links a {
        border: 1px solid var(--line);
        border-radius: 999px;
        color: #334155;
        font-size: 12px;
        font-weight: 700;
        padding: 6px 10px;
      }
      iframe {
        background: #fff;
        border: 0;
        display: block;
        height: 100%;
        min-height: 520px;
        width: 100%;
      }
      .diagnostics-pane ul {
        display: grid;
        gap: 8px;
        list-style: none;
        margin: 0;
        padding: 14px;
      }
      .diagnostics-pane li {
        background: #f8fafc;
        border: 1px solid var(--line-soft);
        border-radius: 6px;
        color: #334155;
        font-size: 12px;
        padding: 8px 10px;
      }
      .diagnostics-pane li[data-severity="error"] {
        border-color: #fecaca;
        color: #991b1b;
      }
      .diagnostics-pane li[data-severity="warning"] {
        border-color: #fde68a;
        color: #92400e;
      }
      @media (max-width: 1000px) {
        main,
        main[data-sidebar-collapsed="true"],
        .preview-shell,
        .example-header {
          grid-template-columns: 1fr;
        }
        .example-main { order: 1; }
        .example-sidebar {
          max-height: none;
          order: 2;
          position: static;
        }
        .example-actions { justify-content: flex-start; }
        .dynamic-preview-output,
        .fallback-frame-wrap {
          height: auto;
          max-height: 680px;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <div class="brand">
          <img src={`${base}/assets/markvspec-icon.svg`} alt="" width="30" height="30" />
          <strong>MarkVSpec Examples</strong>
          <span>Read-only Dynamic Preview</span>
        </div>
        <nav class="top-nav" aria-label="Example navigation">
          <a class="nav-link" href={`${base}/en/`}>
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 7v14" />
              <path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z" />
            </svg>
            <span>Docs</span>
          </a>
          <a class="nav-link" href={githubRepositoryUrl}>
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
              <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.08 1.83 2.82 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.31-5.47-1.34-5.47-5.94 0-1.31.47-2.38 1.23-3.22-.12-.3-.53-1.53.12-3.18 0 0 1-.32 3.3 1.23a11.47 11.47 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.65.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.62-2.81 5.63-5.49 5.93.43.37.82 1.1.82 2.22v3.29c0 .32.21.7.83.58A12 12 0 0 0 12 .5Z" />
            </svg>
            <span>GitHub</span>
          </a>
        </nav>
      </div>
    </header>

    <main data-pagefind-ignore data-example-layout>
      <aside class="example-sidebar" aria-label="Example navigation">
        <div class="example-sidebar-header">
          <a class="example-sidebar-title" href={`${base}/examples/`}>All Examples</a>
          <button class="example-sidebar-toggle" type="button" aria-controls="example-sidebar-content" aria-expanded="true" aria-label="Hide example navigation" data-sidebar-toggle>
            <span class="sidebar-toggle-icon" aria-hidden="true" data-sidebar-toggle-icon>‹</span>
            <span class="sidebar-toggle-label" data-sidebar-toggle-label>Hide</span>
          </button>
        </div>
        <div id="example-sidebar-content" class="example-sidebar-content">
          {stageGroups.map((stage) => (
            <section class="example-sidebar-section">
              <p class="example-sidebar-heading">{stage.label}</p>
              <ul>
                {stage.items.map((item) => (
                  <li>
                    <a href={`${base}/examples/dynamic/${item.slug}.html`} aria-current={item.slug === example.slug ? 'page' : undefined}>{item.title}</a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </aside>

      <div class="example-main">
        <section class="example-header">
          <div>
            <div class="breadcrumb">Examples / {example.relativeExamplePath}</div>
            <h1>{example.title}</h1>
            <p class="subtitle">{example.summary}</p>
            <div class="meta-row" aria-label="Example metadata">
              {metaPills.map((pill) => <span class="pill">{pill}</span>)}
            </div>
          </div>
          <div class="example-actions">
            <a class="nav-link" href={showcaseHref}>Open showcase</a>
          </div>
        </section>

        <section class="runtime-summary" aria-label="Dynamic preview runtime status">
          <strong>Read-only Dynamic Preview</strong>
          <p>Browser-side generated design document rendering from the published `.vspec.md` source asset. Runtime failures show diagnostics and source links instead of a pre-generated HTML artifact.</p>
          <p><span data-dynamic-preview-status data-status="loading">Loading</span></p>
          <p data-dynamic-preview-metrics>Runtime metrics are measured in the browser.</p>
        </section>

        <section class="preview-shell" aria-label="Dynamic preview and diagnostics">
          <article class="preview-pane" aria-label="Browser-rendered preview">
            <div class="pane-header">
              <div class="pane-title">
                <strong>Browser-rendered Preview</strong>
                <span>Generated from {example.sourceAssetPath}</span>
              </div>
            </div>
            <div class="dynamic-preview-output" data-dynamic-preview-output hidden></div>
            <div class="fallback-frame-wrap" data-dynamic-preview-fallback hidden></div>
          </article>

          <aside class="diagnostics-pane" aria-label="Dynamic preview diagnostics">
            <div class="pane-header">
              <div class="pane-title">
                <strong>Diagnostics</strong>
                <span>parse / validate result</span>
              </div>
            </div>
            <ul data-dynamic-preview-diagnostics>
              <li>Waiting for browser runtime.</li>
            </ul>
          </aside>
        </section>
      </div>
    </main>

    <script id="dynamic-preview-config" type="application/json" set:html={JSON.stringify(config)}></script>
    <script is:inline>
      (() => {
        const layout = document.querySelector('[data-example-layout]');
        const button = document.querySelector('[data-sidebar-toggle]');
        const content = document.querySelector('#example-sidebar-content');
        const icon = document.querySelector('[data-sidebar-toggle-icon]');
        const label = document.querySelector('[data-sidebar-toggle-label]');
        if (!layout || !button || !content || !icon || !label) return;

        const setCollapsed = (collapsed) => {
          layout.dataset.sidebarCollapsed = collapsed ? 'true' : 'false';
          button.setAttribute('aria-expanded', String(!collapsed));
          button.setAttribute('aria-label', collapsed ? 'Show example navigation' : 'Hide example navigation');
          content.hidden = collapsed;
          icon.textContent = collapsed ? '›' : '‹';
          label.textContent = collapsed ? 'Show' : 'Hide';
        };

        setCollapsed(window.matchMedia('(max-width: 1000px)').matches);
        button.addEventListener('click', () => {
          setCollapsed(layout.dataset.sidebarCollapsed !== 'true');
        });
      })();
    </script>
    <script is:inline src={`${base}/examples/assets/markvspec-mermaid.js`}></script>
    <script is:inline src={`${base}/examples/assets/markvspec-mermaid-runtime.js`}></script>
    <script>
      import '../../../lib/dynamic-preview.js';
    </script>
  </body>
</html>
