{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run MarkVSpec Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-extension",
        "${workspaceFolder}/examples/screens/login.vspec.md"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/vscode-extension/dist/**/*.js"
      ]
    }
  ]
}
